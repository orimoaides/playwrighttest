# ============================================================
# AI プロバイダ設定（どちらか一方）
# ============================================================

# --- 既定: Google Gemini を直接使う ---
AI_PROVIDER=gemini
GEMINI_API_KEY=AIza...your-key...
# GEMINI_MODEL=gemini-2.5-flash   # 任意（既定 gemini-2.5-flash）

# --- Dify のチャットボット経由で使う場合はこちらに切替 ---
# AI_PROVIDER=dify
# DIFY_API_KEY=app-...your-app-key...
# DIFY_BASE_URL=https://api.dify.ai/v1   # セルフホスト時は差し替え

